# Files that run inside Linux guests or under bash must keep LF line endings on every
# checkout (Windows hosts with core.autocrlf=true would otherwise break them).
*.sh          text eol=lf
guest/init    text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.template    text eol=lf
*.conf        text eol=lf
*.rs          text eol=lf
*.toml        text eol=lf
*.md          text eol=lf
*.xml         text eol=lf
*.ps1         text eol=crlf
